import "./client"
import "./billingAccount"

/// Provider usage per AI call. Internal cost telemetry, never a customer entitlement.
model AiUsage {
    id           String     @id @default(uuid())
    clientSiteId String
    clientSite   ClientSite @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    action       String
    tokens       Int
    metadata     Json
    createdAt    DateTime   @default(now())
    @@index([clientSiteId, createdAt])
    @@index([action, createdAt])
    @@deny('all', true)
}

/// Server-owned operation allowances and provider-cost funding, separate from article balances.
model AiAllowanceGrant {
    id String @id @default(uuid())
    accountId String
    account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
    /// The blog the grant was made for; an agency's subscription funding belongs to no blog.
    clientSiteId String?
    clientSite ClientSite? @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
    kind String
    source String
    amount Int
    remaining Int
    periodStart DateTime?
    expiresAt DateTime?
    idempotencyKey String @unique
    policyVersion String
    createdAt DateTime @default(now())
    @@index([accountId, kind, expiresAt])
    @@index([clientSiteId])
    @@deny('all', true)
}

/// Records every recognized paid invoice, even when its funding is zero.
model AiAllowanceInvoice {
    id String @id
    accountId String
    account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
    clientSiteId String?
    clientSite ClientSite? @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
    grantedMicros Int
    policyVersion String
    createdAt DateTime @default(now())
    @@index([accountId, createdAt])
    @@index([clientSiteId])
    @@deny('all', true)
}

/// Reserves before provider work; unknown-cost failures retain their conservative reservation.
model AiUsageReservation {
    id String @id @default(uuid())
    accountId String
    account BillingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
    clientSiteId String
    clientSite ClientSite @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
    kind String
    reserved Int
    charged Int?
    status String @default("RESERVED")
    allocations Json
    metadata Json
    expiresAt DateTime
    createdAt DateTime @default(now())
    completedAt DateTime?
    @@index([accountId, status, expiresAt])
    @@index([clientSiteId, createdAt])
    @@deny('all', true)
}
