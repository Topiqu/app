import "./client"
import "./billingAccount"

/// One per billing account: a blog's own DIRECT account, or an agency's shared pool.
model ArticleCreditWallet {
    id String @id
    account BillingAccount @relation(fields: [id], references: [id], onDelete: Restrict)
    grants ArticleCreditGrant[]
    operations ArticleCreditOperation[]
    entries ArticleCreditLedgerEntry[]
    balance Int @default(0)
    reserved Int @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    @@deny('all', true)
}

/// `clientSiteId` is the blog a grant was made for; an agency's subscription grants belong to no blog.
model ArticleCreditGrant {
    id String @id @default(uuid())
    accountId String
    wallet ArticleCreditWallet @relation(fields: [accountId], references: [id], onDelete: Restrict)
    clientSiteId String?
    clientSite ClientSite? @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
    entries ArticleCreditLedgerEntry[]
    source String
    amount Int
    remaining Int
    expiresAt DateTime?
    periodStart DateTime?
    periodEnd DateTime?
    policyVersion String
    idempotencyKey String @unique
    createdAt DateTime @default(now())
    @@index([accountId, expiresAt])
    @@index([clientSiteId])
    @@deny('all', true)
}

/// `clientSiteId` is the blog that spent the credits.
model ArticleCreditOperation {
    id String @id @default(uuid())
    accountId String
    wallet ArticleCreditWallet @relation(fields: [accountId], references: [id], onDelete: Restrict)
    clientSiteId String
    clientSite ClientSite @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
    entries ArticleCreditLedgerEntry[]
    action String
    status String @default('RESERVED')
    reserved Int @default(1)
    charged Int @default(0)
    allocations Json
    metadata Json
    idempotencyKey String @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
    completedAt DateTime?
    @@index([accountId, createdAt])
    @@index([clientSiteId, createdAt])
    @@index([status, expiresAt])
    @@deny('all', true)
}

model ArticleCreditLedgerEntry {
    id String @id @default(uuid())
    accountId String
    wallet ArticleCreditWallet @relation(fields: [accountId], references: [id], onDelete: Restrict)
    clientSiteId String?
    clientSite ClientSite? @relation(fields: [clientSiteId], references: [id], onDelete: Restrict)
    kind String
    amount Int
    operationId String?
    operation ArticleCreditOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
    grantId String?
    grant ArticleCreditGrant? @relation(fields: [grantId], references: [id], onDelete: Restrict)
    reason String
    idempotencyKey String @unique
    createdAt DateTime @default(now())
    @@index([accountId, createdAt, id])
    @@index([clientSiteId, createdAt, id])
    @@deny('all', true)
}
