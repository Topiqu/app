import "./base"
import "./client"
import "./user"

enum KnowledgeSourceKind {
    NOTE
    FILE
    URL
    FEED
}

enum KnowledgeSourceStatus {
    PENDING
    PROCESSING
    INDEXED
    FAILED
}

/// Google Merchant's vocabulary; Heureka's DELIVERY_DATE maps onto it.
enum KnowledgeProductAvailability {
    IN_STOCK
    PREORDER
    BACKORDER
    OUT_OF_STOCK
}

/// `content` is the extracted text and the only copy of it: uploaded files are never stored, so
/// there is no private object behind a public CDN bucket. `publicUrl` alone makes a source citable.
model KnowledgeSource with Base {
    clientSiteId     String
    clientSite       ClientSite            @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    createdById      String?
    createdBy        User?                 @relation("KnowledgeSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
    kind             KnowledgeSourceKind
    title            String                @length(1, 200)
    status           KnowledgeSourceStatus @default(PENDING)
    useInArticles    Boolean               @default(true)
    publicUrl        String?               @length(0, 2048)
    sourceUrl        String?               @length(0, 2048)
    originalFilename String?               @length(0, 255)
    mimeType         String?               @length(0, 100)
    sizeBytes        Int?
    content          String
    contentHash      String                @length(64, 64)
    version          Int                   @default(1)
    embeddingModel   String?
    chunkCount       Int                   @default(0)
    attempts         Int                   @default(0)
    error            String?               @length(0, 500)
    indexedAt        DateTime?
    /// When the content was true; staleness review reads this, falling back to fetchedAt, then indexedAt.
    validAsOf        DateTime?
    fetchedAt        DateTime?
    usageCount       Int                   @default(0)
    lastUsedAt       DateTime?
    /// FEED only: retrieval serves the feed to articles in this language, so links match the shop's locale.
    language         Language?
    /// FEED only: the currency of prices that carry none (Heureka).
    currency         String?               @length(3, 3)
    /// FEED only: counts from the last successful sync (`KnowledgeFeedReport`).
    syncReport       Json?
    chunks           KnowledgeChunk[]
    products         KnowledgeProduct[]

    @@allow('read', auth().role == 'superadmin' || auth().clientSiteId == clientSiteId)
    @@allow('all', auth().role == 'admin' && auth().clientSiteId == clientSiteId)
    @@index([clientSiteId, createdAt])
    @@index([clientSiteId, contentHash])
    @@index([status, updatedAt])
    @@index([kind, fetchedAt])
}

/// Written and searched only by `server/utils/knowledge/*` through raw SQL (pgvector); the policy
/// denies every ORM path so a route can never list another tenant's chunks by accident.
model KnowledgeChunk {
    id           String                  @id @default(uuid())
    createdAt    DateTime                @default(now())
    sourceId     String
    source       KnowledgeSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
    clientSiteId String
    version      Int
    ordinal      Int
    content      String
    embedding    Unsupported("vector(1536)")?
    searchVector Unsupported("tsvector")?
    productId    String?
    product      KnowledgeProduct?       @relation(fields: [productId], references: [id], onDelete: Cascade)

    @@deny('all', true)
    @@index([clientSiteId])
    @@index([sourceId, version])
    @@index([productId])
}

/// One product of a FEED source, variants merged. Only the feed sync writes it, so no policy allows
/// a write. `textHash` is set in the same transaction as the product's chunk: an interrupted sync
/// re-embeds the product instead of skipping it.
model KnowledgeProduct {
    id           String                       @id @default(uuid())
    updatedAt    DateTime?                    @updatedAt
    sourceId     String
    source       KnowledgeSource              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
    clientSiteId String
    externalId   String                       @length(1, 128)
    name         String                       @length(1, 200)
    url          String                       @length(1, 2048)
    price        Decimal?                     @db.Decimal(12, 2)
    currency     String?                      @length(3, 3)
    availability KnowledgeProductAvailability
    textHash     String?                      @length(64, 64)
    chunks       KnowledgeChunk[]

    @@allow('read', auth().role == 'superadmin' || auth().clientSiteId == clientSiteId)
    @@unique([sourceId, externalId])
    @@index([clientSiteId])
}
