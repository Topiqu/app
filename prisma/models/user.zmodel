import "./base"
import "./article"
import "./client"
import "./comment"
import "./notification"
import "./linkedin"
import "./log"
import "./media"
import "./knowledge"
import "./generation"

model User with Base {
    username                      String            @unique @length(3, 50, "Uživatelské jméno musí mít 3–50 znaků")
    email                         String            @unique @length(3, 255, "Email musí mít 3–255 znaků")
    password                      String?           @omit @length(4, 124, "Heslo musí mít 4–124 znaků")
    bio                           String?           @length(0, 300, "Bio může mít max. 300 znaků")
    role                          UserRole          @default(reader)
    avatarUrl                     String?
    verification                  VerificationCode?
    totpSecret                    String?           @omit
    totpTempSecret                String?           @omit
    onboardingLoginToken          String?           @omit
    onboardingLoginTokenExpiresAt DateTime?
    emailVerified                 Boolean           @default(false)
    allowNotifs                   Boolean           @default(true)
    allowEmail                    Boolean           @default(true)
    lastLogin                     DateTime?         @default(now())
    language                      Language          @default(en)
    sessions                      Session[]         @relation("UserSessions")
    accounts                      Account[]
    clientSiteId                  String?
    theme                         ThemeOption       @default(light)
    clientSite                    ClientSite?       @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    articles                      Article[]
    articleDrafts                 ArticleDraft[]
    comments                      Comment[]
    notifications                 Notification[]
    reactions                     CommentReaction[]
    feedbacks                     ArticleFeedback[]
    emojiReactions                EmojiReaction[]
    articleReactions              ArticleReaction[]
    articleShares                 ArticleShare[]
    articleViews                  ArticleView[]
    followers                     Follow[]          @relation("Follower")
    following                     Follow[]          @relation("Followed")
    bans                          UserBan[]         @relation("BannedUser")
    bansIssued                    UserBan[]         @relation("BannedBy")
    logs                          Log[]             @relation("LogToUser")
    mediaAssets                   MediaAsset[]      @relation("MediaAssetCreator")
    mediaRightsConfirmations      MediaAsset[]      @relation("MediaRightsConfirmer")
    mediaPublicationConfirmations MediaRightsPublicationSnapshot[] @relation("MediaPublicationConfirmer")
    articleGenerationSessions     ArticleGenerationSession[]
    knowledgeSources              KnowledgeSource[] @relation("KnowledgeSourceCreator")
    approvals                     Approval[]
    tenantMemberships             TenantMembership[]
    tenantInvitations             TenantInvitation[] @relation("InvitationSender")
    @@allow('read', true)
    @@allow('create', true)
    @@allow('update', auth().id == id)
    // The publication's AI persona is site configuration, edited by that site's admins.
    @@allow('update', auth().role == 'admin' && role == 'ai' && clientSiteId == auth().clientSiteId)
    @@allow('all', auth().role == 'superadmin')
    @@index([username, email, role, language, allowNotifs])
}

model TenantMembership with Base {
    clientSiteId String
    clientSite   ClientSite    @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    userId       String
    user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    role         TenantRole    @default(MEMBER)
    scopes       TenantScope[]

    @@unique([clientSiteId, userId])
    @@index([userId])
    @@allow('read', auth().role == 'superadmin' || auth().id == userId || auth().clientSiteId == clientSiteId)
    @@allow('all', auth().role == 'superadmin')
}

model TenantInvitation with Base {
    clientSiteId  String
    clientSite    ClientSite    @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    email         String
    tokenHash     String         @unique @omit
    scopes        TenantScope[]
    invitedById   String
    invitedBy     User           @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
    expiresAt     DateTime
    acceptedAt    DateTime?
    revokedAt     DateTime?

    @@index([clientSiteId, email])
    @@index([expiresAt])
    @@allow('read', auth().role == 'superadmin' || auth().clientSiteId == clientSiteId)
    @@allow('all', auth().role == 'superadmin')
}

// Better Auth session. Revoking one deletes the row; only the auth adapter sees `token`.
model Session with Base {
    origin     String?  @length(0, 300)
    token      String   @unique @omit
    expiresAt  DateTime
    ip         String?  @length(0, 45)
    userAgent  String?  @length(0, 500)
    device     String?  @length(0, 100)
    os         String?  @length(0, 100)
    browser    String?  @length(0, 100)
    city       String?  @length(0, 100)
    region     String?  @length(0, 100)
    country    String?  @length(0, 100)
    lastUsedAt DateTime @default(now())
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, name: "UserSessions")
    clientSiteId String?
    clientSite   ClientSite? @relation("SessionActiveTenant", fields: [clientSiteId], references: [id], onDelete: SetNull)
    @@allow('read,update,delete', auth().id == userId)
    @@allow('all', auth().role == 'superadmin')
    @@index([userId, lastUsedAt])
    @@index([clientSiteId])
}

// Better Auth OAuth identity. Credentials stay on `User.password`, so there is no credential row.
model Account with Base {
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?   @omit
    refreshToken          String?   @omit
    idToken               String?   @omit
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?   @omit
    @@unique([providerId, accountId])
    @@index([userId])
}

// Better Auth OAuth state.
model Verification with Base {
    identifier String
    value      String   @omit
    expiresAt  DateTime
    @@index([identifier])
}

model Follow {
    followerId String
    followedId String
    follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
    followed   User     @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())
    @@id([followerId, followedId])
    @@allow('create', auth().id == followerId)
    @@allow('delete', auth().id == followerId || auth().role == 'superadmin')
    @@allow('read', true)
}

model UserBan with Base {
    userId       String
    user         User       @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
    clientSiteId String
    clientSite   ClientSite @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    reason       String?    @length(0, 255, "Důvod banu může mít max. 255 znaků")
    bannedById   String
    bannedBy     User       @relation("BannedBy", fields: [bannedById], references: [id], onDelete: Cascade)
    expiresAt    DateTime?
    @@allow('read', true)
    @@allow('create, update, delete', auth().role == 'admin' && auth().clientSiteId == clientSiteId)
    @@allow('all', auth().role == 'superadmin')
}

model VerificationCode with Base, Ownable {
    code      String   @length(8, 8, "Kód musí mít přesně 8 znaků")
    expiresAt DateTime
    @@unique([userId])
    @@allow('all', true)
}
