import "./base"
import "./client"
import "./article"
import "./knowledge"

enum ShopifyConnectionStatus {
    CONNECTED
    REAUTH_REQUIRED
    REVOKED
}

enum ShopifyPublicationStatus {
    QUEUED
    PUBLISHING
    SYNCED
    FAILED
    UNCERTAIN
}

model ShopifyConnection with Base {
    clientSiteId String @unique
    clientSite ClientSite @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    shop String @unique
    shopName String
    storefrontUrl String
    blogId String?
    blogTitle String?
    author String?
    encryptedAccessToken String? @omit
    encryptedRefreshToken String? @omit
    accessTokenExpiresAt DateTime?
    refreshTokenExpiresAt DateTime?
    refreshLease String? @omit
    refreshLeaseUntil DateTime?
    grantedScopes String[]
    status ShopifyConnectionStatus @default(CONNECTED)
    publications ShopifyPublication[]
    knowledgeSource KnowledgeSource?
    catalogRevision Int @default(0)
    catalogSyncedRevision Int @default(0)
    shopGid String?
    // Handle of the Shopify App Pricing plan last applied to the project; null when none is active.
    planHandle String?
    planCheckedAt DateTime?
    @@allow('read', auth().role == 'superadmin' || (auth().role == 'admin' && auth().clientSiteId == clientSiteId))
    @@allow('create, update, delete', auth().role == 'superadmin' || (auth().role == 'admin' && auth().clientSiteId == clientSiteId))
}

model ShopifyPublication with Base {
    clientSiteId String
    clientSite ClientSite @relation(fields: [clientSiteId], references: [id], onDelete: Cascade)
    articleId String
    article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
    connectionId String
    connection ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
    shopifyArticleId String?
    blogId String
    handle String
    url String?
    status ShopifyPublicationStatus @default(QUEUED)
    isPublished Boolean @default(false)
    payload Json @omit
    attempts Int @default(0)
    nextAttemptAt DateTime @default(now())
    lease String? @omit
    leaseUntil DateTime?
    createStartedAt DateTime?
    lastSyncedAt DateTime?
    lastError String?
    @@unique([connectionId, articleId])
    @@index([status, nextAttemptAt])
    @@allow('read', auth().role == 'superadmin' || (auth().role == 'admin' && auth().clientSiteId == clientSiteId))
    @@allow('create, update, delete', auth().role == 'superadmin' || (auth().role == 'admin' && auth().clientSiteId == clientSiteId))
}

// A store that installed the app but is not linked to a project yet.
model ShopifyInstallation {
    id String @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    shop String @unique
    shopGid String
    shopName String
    storefrontUrl String
    encryptedAccessToken String @omit
    encryptedRefreshToken String @omit
    accessTokenExpiresAt DateTime
    refreshTokenExpiresAt DateTime
    grantedScopes String[]
    @@allow('all', false)
}
