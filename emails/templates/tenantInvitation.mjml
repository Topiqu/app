<mjml
  ><mj-head
    ><mj-preview>{t:tenantInvitation.subject}</mj-preview
    ><mj-attributes
      ><mj-all font-family="Inter,Arial,sans-serif" /><mj-text
        color="#27272a"
        line-height="1.6"
        font-size="15px" /></mj-attributes></mj-head
  ><mj-body background-color="#f4f4f5"
    ><mj-section padding="32px 16px 16px"
      ><mj-column><mj-image src="{logoUrl}" width="110px" /></mj-column></mj-section
    ><mj-section background-color="#ffffff" border-radius="20px" padding="32px"
      ><mj-column
        ><mj-text font-size="22px" font-weight="700">{t:tenantInvitation.greeting}</mj-text
        ><mj-text>{t:tenantInvitation.intro}</mj-text
        ><mj-button href="{invitationUrl}" background-color="#18181b" border-radius="10px" padding="16px 0"
          >{t:tenantInvitation.button}</mj-button
        ><mj-text color="#71717a" font-size="13px">{t:tenantInvitation.expiration}</mj-text></mj-column
      ></mj-section
    ></mj-body
  ></mjml
>
