<mjml>
  <mj-head>
    <mj-preview>{t:tenantInvitation.subject}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter,Arial,sans-serif" />
      <mj-text color="#27272a" line-height="1.6" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f5">
    <mj-section padding="32px 16px 16px">
      <mj-column><mj-image src="{logoUrl}" width="110px" alt="Topiqu" /></mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="20px 20px 0 0" padding="32px 32px 20px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="700" padding-bottom="8px">
          {t:tenantInvitation.greeting}
        </mj-text>
        <mj-text align="center" color="#52525b" padding-top="0">{t:tenantInvitation.intro}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fafafa" padding="24px 28px">
      <mj-column width="96px" vertical-align="middle">
        <mj-image
          src="{tenantLogoUrl}"
          alt="{tenantName}"
          width="72px"
          height="72px"
          border-radius="16px"
          padding="0"
        />
      </mj-column>
      <mj-column vertical-align="middle">
        <mj-text font-size="20px" font-weight="700" padding="0 0 4px">{tenantName}</mj-text>
        <mj-text color="#52525b" padding="0">{tenantDescription}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="22px 28px 8px">
      <mj-column width="50%">
        <mj-text align="center" font-size="22px" font-weight="700" padding-bottom="0">{followerCount}</mj-text>
        <mj-text align="center" color="#71717a" font-size="12px" text-transform="uppercase" padding-top="2px">
          {t:tenantInvitation.followers}
        </mj-text>
      </mj-column>
      <mj-column width="50%">
        <mj-text align="center" font-size="15px" font-weight="600" padding-bottom="0">{tenantDomain}</mj-text>
        <mj-text align="center" color="#71717a" font-size="12px" text-transform="uppercase" padding-top="2px">
          {t:tenantInvitation.website}
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="0 0 20px 20px" padding="8px 32px 32px">
      <mj-column>
        <mj-text align="center" color="#52525b" font-size="13px" padding="0 0 8px">{t:tenantInvitation.access}</mj-text>
        <mj-button
          href="{invitationUrl}"
          background-color="#18181b"
          color="#ffffff"
          font-weight="700"
          border-radius="10px"
          padding="12px 0 18px"
        >
          {t:tenantInvitation.button}
        </mj-button>
        <mj-text align="center" color="#71717a" font-size="13px" padding="0">{t:tenantInvitation.expiration}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text align="center" color="#a1a1aa" font-size="12px">{t:tenantInvitation.community}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
