<mjml>
  <mj-head>
    <mj-preview>{t:tenantMemberRemoved.subject}</mj-preview>
    <mj-attributes>
      <mj-all font-family="Inter,Arial,sans-serif" />
      <mj-text color="#3f3f46" line-height="1.6" font-size="15px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f5">
    <mj-section padding="32px 16px 16px">
      <mj-column><mj-image src="{logoUrl}" width="110px" alt="Topiqu" /></mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="20px" padding="32px">
      <mj-column>
        <mj-image src="{tenantLogoUrl}" alt="{tenantName}" width="72px" height="72px" border-radius="16px" padding="0 0 18px" />
        <mj-text align="center" font-size="23px" font-weight="700" padding="0 0 8px">{t:tenantMemberRemoved.greeting}</mj-text>
        <mj-text align="center" color="#52525b" padding="0 0 24px">{t:tenantMemberRemoved.intro}</mj-text>
        <mj-table cellpadding="0" cellspacing="0">
          <tr><td style="padding:10px 12px;color:#71717a;border-bottom:1px solid #e4e4e7">{t:tenantMemberRemoved.removedByLabel}</td><td style="padding:10px 12px;text-align:right;border-bottom:1px solid #e4e4e7"><strong>{removedBy}</strong></td></tr>
          <tr><td style="padding:10px 12px;color:#71717a">{t:tenantMemberRemoved.removedAtLabel}</td><td style="padding:10px 12px;text-align:right"><strong>{removedAt}</strong></td></tr>
        </mj-table>
        <mj-text padding="24px 0 8px">{t:tenantMemberRemoved.otherTenants}</mj-text>
        <mj-text padding="0" color="#71717a">{t:tenantMemberRemoved.contact}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
