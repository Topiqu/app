<mjml>
  <mj-head>
    <mj-preview>{t:deleteComment.subject}</mj-preview>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#3F3F46" font-size="15px" line-height="24px" padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      .card {
        border: 1px solid #e4e4e7;
        border-radius: 20px;
      }
      .eyebrow {
        color: #d97706;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
      }
      .title {
        color: #18181b;
        font-size: 24px;
        font-weight: 800;
        line-height: 31px;
        letter-spacing: -0.4px;
      }
      .removed {
        background-color: #fafafa;
        border-radius: 12px;
        color: #52525b;
        font-style: italic;
      }
      .reason {
        background-color: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 12px;
        color: #92400e;
        font-weight: 600;
      }
      .footer,
      .footer a {
        color: #71717a;
        font-size: 12px;
      }
      .footer a {
        color: #7c3aed;
        font-weight: 600;
        text-decoration: none;
      }
      @media (prefers-color-scheme: dark) {
        body,
        .body-bg {
          background-color: #09090b !important;
        }
        .card-bg {
          background-color: #18181b !important;
          border-color: #3f3f46 !important;
        }
        .title {
          color: #fafafa !important;
        }
        .copy {
          color: #d4d4d8 !important;
        }
        .removed {
          background-color: #27272a !important;
          color: #d4d4d8 !important;
        }
        .reason {
          background-color: #422006 !important;
          border-color: #78350f !important;
          color: #fde68a !important;
        }
        .footer {
          color: #a1a1aa !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F4F5" css-class="body-bg" width="640px">
    <mj-wrapper padding="32px 16px">
      <mj-section padding="0 0 20px"
        ><mj-column><mj-image src="{logoUrl}" alt="Topiqu" width="120px" padding="0" /></mj-column
      ></mj-section>
      <mj-section background-color="#FFFFFF" css-class="card card-bg" padding="36px 32px">
        <mj-column>
          <mj-text css-class="eyebrow" padding="0 0 10px">Topiqu</mj-text>
          <mj-text css-class="title" padding="0 0 20px">{t:deleteComment.subject}</mj-text>
          <mj-text css-class="copy" padding="0 0 18px">{t:deleteComment.greeting}</mj-text>
          <mj-text css-class="removed" padding="16px 18px">{t:deleteComment.intro}</mj-text>
          <mj-text css-class="reason" padding="14px 16px">{t:deleteComment.reason}</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="22px 12px 0"
        ><mj-column
          ><mj-text css-class="footer" align="center"
            >{t:deleteComment.unsubscribe.text}
            <a href="{unsubscribeUrl}">{t:deleteComment.unsubscribe.link}</a></mj-text
          ></mj-column
        ></mj-section
      >
    </mj-wrapper>
  </mj-body>
</mjml>
