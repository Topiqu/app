<mjml>
  <mj-head>
    <mj-preview>{t:newComment.subject}</mj-preview>
    <mj-font
      name="Inter"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#3F3F46" font-size="15px" line-height="24px" padding="0" />
      <mj-button
        background-color="#7C3AED"
        color="#FFFFFF"
        font-size="15px"
        font-weight="700"
        border-radius="10px"
        inner-padding="13px 24px"
        padding="0"
      />
    </mj-attributes>
    <mj-style inline="inline">
      .card {
        border: 1px solid #e4e4e7;
        border-radius: 20px;
      }
      .eyebrow {
        color: #7c3aed;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
      }
      .title {
        color: #18181b;
        font-size: 24px;
        font-weight: 800;
        line-height: 31px;
        letter-spacing: -0.4px;
      }
      .quote {
        background-color: #f7f5ff;
        border-left: 4px solid #8b5cf6;
        border-radius: 0 12px 12px 0;
        color: #3f3f46;
      }
      .footer,
      .footer a {
        color: #71717a;
        font-size: 12px;
      }
      .footer a {
        color: #7c3aed;
        font-weight: 600;
        text-decoration: none;
      }
      @media (prefers-color-scheme: dark) {
        body,
        .body-bg {
          background-color: #09090b !important;
        }
        .card-bg {
          background-color: #18181b !important;
          border-color: #3f3f46 !important;
        }
        .title {
          color: #fafafa !important;
        }
        .copy {
          color: #d4d4d8 !important;
        }
        .quote {
          background-color: #27272a !important;
          color: #e4e4e7 !important;
        }
        .footer {
          color: #a1a1aa !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F4F5" css-class="body-bg" width="640px">
    <mj-wrapper padding="32px 16px">
      <mj-section padding="0 0 20px"
        ><mj-column><mj-image src="{logoUrl}" alt="Topiqu" width="120px" padding="0" /></mj-column
      ></mj-section>
      <mj-section background-color="#FFFFFF" css-class="card card-bg" padding="36px 32px">
        <mj-column>
          <mj-text css-class="eyebrow" padding="0 0 10px">Topiqu</mj-text>
          <mj-text css-class="title" padding="0 0 20px">{t:newComment.subject}</mj-text>
          <mj-text css-class="copy" padding="0 0 18px">{t:newComment.greeting}</mj-text>
          <mj-text css-class="quote" padding="18px 20px">{t:newComment.intro}</mj-text>
          <mj-button href="{commentUrl}" align="left" padding="26px 0 0">{t:newComment.button}</mj-button>
        </mj-column>
      </mj-section>
      <mj-section padding="22px 12px 0"
        ><mj-column
          ><mj-text css-class="footer" align="center"
            >{t:newComment.unsubscribe.text} <a href="{unsubscribeUrl}">{t:newComment.unsubscribe.link}</a></mj-text
          ></mj-column
        ></mj-section
      >
    </mj-wrapper>
  </mj-body>
</mjml>
