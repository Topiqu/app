{
  "name": "topiqu-blog",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.4.4"
  },
  "type": "module",
  "scripts": {
    "domains:check": "bun scripts/check-domain-providers.ts",
    "build": "bun --bun run zenstack:generate && nuxt build",
    "build:docker": "bun run build",
    "release": "bun db:migrate:deploy",
    "postinstall": "bun --bun x --no-install nuxt prepare",
    "dev": "nuxt dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:fresh": "bun db:reset && bun db:migrate:deploy && bun db:seed",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:ai": "AI_EVAL=1 vitest run tests/eval",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --project=release-smoke",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write --list-different .",
    "fmt": "bun lint:fix && bun prettier:fix",
    "zenstack:generate": "bun --bun x --no-install zen generate --schema ./prisma/schema.zmodel --output ./generated/zenstack",
    "db:migrate:deploy": "zen migrate deploy --schema ./prisma/schema.zmodel",
    "db:seed": "bun run prisma/seed.ts",
    "ai:smoke": "bun run scripts/ai-smoke.ts",
    "knowledge:eval": "bun run scripts/knowledge-eval.ts",
    "seo:check": "bun run scripts/seo-check.ts",
    "perf:check": "bun run scripts/performance-budgets.ts",
    "backup:verify": "bun run scripts/verify-backup-restore.ts",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "openapi:check": "bun run scripts/generate-openapi.ts --check",
    "media:backfill": "bun run scripts/backfill-media-library.ts",
    "stats:backfill-generations": "bun run scripts/backfill-generation-word-counts.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/openai": "4.0.99",
