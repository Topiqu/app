{
  "name": "topiqu-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun zenstack:generate && bun prisma:deploy && nuxt build",
    "build:docker": "bun zenstack:generate && nuxt build",
    "release": "bun prisma:deploy",
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:fresh": "bun db:reset && bun prisma:deploy && bun db:seed",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write --list-different .",
    "fmt": "bun lint:fix && bun prettier:fix",
    "zenstack:generate": "zenstack generate --schema ./prisma/schema.zmodel",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "ai:smoke": "bun run scripts/ai-smoke.ts",
    "seo:check": "bun run scripts/seo-check.ts",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "openapi:check": "bun run scripts/generate-openapi.ts --check",
    "db:seed-tokens": "bun run scripts/seed-tokens.ts"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
