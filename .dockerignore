.env
.env.*
!.env.example
.vercel

# VCS / CI / editor
.git
.github
.vscode
.idea
.fleet
.claude
.qodo
.ecc
.playwright-cli
.shopify

# Docs & local tooling
*.md
todo
docker-compose.yml
.pr_agent.toml

# Tests — not needed at runtime, and CI already gates them
tests
vitest.config.ts
coverage
test-results
playwright-report
blob-report

# Misc
.DS_Store
logs
*.log
