.env
.env.*
!.env.example
.vercel

# VCS / CI / editor
.git
.github
.vscode
.idea
.fleet
.claude
.qodo

# Docs & local tooling
*.md
todo
docker-compose.yml
.pr_agent.toml

# Tests — not needed at runtime, and CI already gates them
tests
vitest.config.ts

# Misc
.DS_Store
logs
*.log
