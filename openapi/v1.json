{
  "openapi": "3.1.0",
  "info": {
    "title": "Topiqu External API",
    "version": "1.0.0",
    "description": "API for reading published Topiqu articles and, with write scopes, creating, editing, publishing and generating them. Each key has scopes (READ, WRITE, PUBLISH, GENERATE) and acts for the member who created it, never with more rights than that member has. Requests are limited to 120 per minute per key. Clients must ignore unknown response fields so v1 can evolve compatibly.",
    "contact": { "name": "Topiqu support", "url": "https://topiqu.com" }
  },
  "servers": [{ "url": "https://app.topiqu.com/api/v1", "description": "Production" }],
  "tags": [
    { "name": "Articles", "description": "Article content belonging to the authenticated site." },
    { "name": "Generations", "description": "Articles written by Topiqu on request. Each one uses article credits." }
  ],
  "security": [{ "ApiKeyAuth": [] }],
  "x-api-key-scopes": {
    "READ": "Published articles, tags and site details. Every key has it.",
    "WRITE": "Create and edit drafts; read drafts.",
    "PUBLISH": "Publish, unpublish and schedule articles.",
    "GENERATE": "Request AI-written articles; uses article credits."
  },
  "paths": {
    "/articles": {
      "get": {
        "operationId": "listArticles",
        "x-required-scopes": ["READ"],
        "summary": "List published articles",
        "description": "Returns published articles newest first. Multiple tag slugs use AND semantics.",
        "tags": ["Articles"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Comma-separated tag slugs.",
            "schema": { "type": "string" },
            "example": "ai,marketing"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of published articles.",
            "headers": {
              "X-API-Version": { "schema": { "type": "string" }, "description": "Resolved major API version." }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleListResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "post": {
        "operationId": "createArticle",
        "x-required-scopes": ["WRITE"],
        "x-conditional-scopes": [
          {
            "scope": "PUBLISH",
            "when": "The request sets `status` or `releaseAt` (creating a draft needs only WRITE)."
          }
        ],
        "summary": "Create an article",
        "description": "Needs the WRITE scope; publishing or scheduling also PUBLISH. The article is authored by the member who created the key.",
        "tags": ["Articles"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "A unique value per logical request. Completed responses replay for 24 hours with `Idempotent-Replayed: true`. Running or uncertain operations return 409 and retain their claim; do not retry them with a new key. Known client rejections, including 402, may be retried after correction or funding.",
            "schema": { "type": "string", "maxLength": 255 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleCreate" } } }
        },
        "responses": {
          "201": {
            "description": "The created article.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OwnedArticleResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/IdempotencyMismatch" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/articles/{id}": {
      "get": {
        "operationId": "getArticle",
        "x-required-scopes": ["READ"],
        "summary": "Get an article",
        "description": "Published articles for any key. A key with the WRITE scope also reads drafts and gets `status`, `editVersion` and `releaseAt`.",
        "tags": ["Articles"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "The published article.",
            "headers": { "X-API-Version": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "patch": {
        "operationId": "updateArticle",
        "x-required-scopes": ["WRITE"],
        "x-conditional-scopes": [
          {
            "scope": "PUBLISH",
            "when": "The request sets `status` or `releaseAt` (creating a draft needs only WRITE)."
          }
        ],
        "summary": "Update an article",
        "description": "Needs the WRITE scope; changing `status` or `releaseAt` also PUBLISH. Send `expectedVersion` (the `editVersion` you read) to get a 409 instead of overwriting a newer edit; without it the update is last-write-wins.",
        "tags": ["Articles"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "A unique value per logical request. Completed responses replay for 24 hours with `Idempotent-Replayed: true`. Running or uncertain operations return 409 and retain their claim; do not retry them with a new key. Known client rejections, including 402, may be retried after correction or funding.",
            "schema": { "type": "string", "maxLength": 255 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArticleUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "The updated article.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OwnedArticleResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/IdempotencyMismatch" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/articles/generate": {
      "post": {
        "operationId": "generateArticle",
        "x-required-scopes": ["GENERATE"],
        "summary": "Request an AI-written article",
        "description": "Needs the GENERATE scope. Queues the article and returns at once; Topiqu researches and writes it as a draft, then sends the `generation.succeeded` or `generation.failed` webhook. Uses the article credits of one article at the site quality. At most 5 requests can be queued or running per site.",
        "tags": ["Generations"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "A unique value per logical request. Completed responses replay for 24 hours with `Idempotent-Replayed: true`. Running or uncertain operations return 409 and retain their claim; do not retry them with a new key. Known client rejections, including 402, may be retried after correction or funding.",
            "schema": { "type": "string", "maxLength": 255 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerationRequest" } } }
        },
        "responses": {
          "202": {
            "description": "The queued request.",
            "headers": { "Location": { "schema": { "type": "string" }, "description": "Status URL of the request." } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerationResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": { "$ref": "#/components/responses/InsufficientCredits" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/IdempotencyMismatch" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/generations/{id}": {
      "get": {
        "operationId": "getGeneration",
        "x-required-scopes": ["GENERATE"],
        "summary": "Get a generation request",
        "description": "Needs the GENERATE scope.",
        "tags": ["Generations"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "The request and, once written, its draft article ID.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerationResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key created in Topiqu settings (Integrations). It is shown once; Topiqu stores only its SHA-256 hash."
      }
    },
    "schemas": {
      "ArticleSummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "slug",
          "excerpt",
          "imageUrl",
          "aiInvolvement",
          "readingTime",
          "totalWords",
          "createdAt",
          "updatedAt",
          "publishedAt",
          "language",
          "tags",
          "user",
          "articleSeries",
          "availableTranslations"
        ],
        "properties": {
          "id": { "type": "string", "example": "cm123abc" },
          "title": { "type": "string", "example": "How AI changes content operations" },
          "slug": { "type": "string", "example": "how-ai-changes-content-operations" },
          "excerpt": { "type": ["string", "null"] },
          "imageUrl": { "type": ["string", "null"], "format": "uri" },
          "aiInvolvement": { "type": "string", "description": "Level of AI involvement declared by the publisher." },
          "readingTime": { "type": ["integer", "null"], "minimum": 0 },
          "totalWords": { "type": ["integer", "null"], "minimum": 0 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "publishedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
          "language": { "type": "string", "example": "cs" },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "slug"],
              "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "slug": { "type": "string" } }
            }
          },
          "user": {
            "type": "object",
            "required": ["id", "username", "avatarUrl"],
            "properties": {
              "id": { "type": "string" },
              "username": { "type": "string" },
              "avatarUrl": { "type": ["string", "null"] }
            }
          },
          "articleSeries": {
            "oneOf": [
              {
                "type": "object",
                "required": ["id", "name", "slug"],
                "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "slug": { "type": "string" } }
              },
              { "type": "null" }
            ]
          },
          "availableTranslations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "language", "slug", "title", "excerpt", "translatedAt"],
              "properties": {
                "id": { "type": "string" },
                "language": { "type": "string", "example": "en" },
                "slug": { "type": ["string", "null"] },
                "title": { "type": ["string", "null"] },
                "excerpt": { "type": ["string", "null"] },
                "translatedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
              }
            }
          }
        }
      },
      "Article": {
        "allOf": [
          { "$ref": "#/components/schemas/ArticleSummary" },
          {
            "type": "object",
            "required": ["content", "imageCredit", "sources", "allowedComments"],
            "properties": {
              "content": { "type": "string", "description": "Article body as sanitized HTML." },
              "imageCredit": { "type": ["object", "array", "string", "number", "boolean", "null"] },
              "sources": { "type": "array", "items": { "type": "string" } },
              "allowedComments": { "type": "boolean" }
            }
          }
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "required": ["total", "page", "limit", "primaryLanguage", "appliedFilters"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "primaryLanguage": { "type": "string" },
          "appliedFilters": {
            "type": "object",
            "required": ["tags"],
            "properties": { "tags": { "type": "array", "items": { "type": "string" } } }
          }
        }
      },
      "ArticleListResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ArticleSummary" } },
          "meta": { "$ref": "#/components/schemas/PaginationMeta" }
        }
      },
      "ArticleResponse": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Article" } }
      },
      "OwnedArticle": {
        "allOf": [
          { "$ref": "#/components/schemas/Article" },
          {
            "type": "object",
            "required": ["status", "editVersion", "releaseAt"],
            "properties": {
              "status": { "type": "string", "enum": ["draft", "published", "archived"] },
              "editVersion": { "type": "integer", "minimum": 0 },
              "releaseAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
            }
          }
        ]
      },
      "OwnedArticleResponse": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/OwnedArticle" } }
      },
      "ArticleCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "content": {
            "type": "string",
            "maxLength": 500000,
            "description": "HTML. It is sanitized like editor content."
          },
          "excerpt": { "type": ["string", "null"] },
          "slug": {
            "type": "string",
            "maxLength": 100,
            "description": "Normalized; derived from the title when omitted."
          },
          "tags": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string", "maxLength": 64 },
            "description": "Slugs of existing tags of the site. The list replaces the article tags."
          },
          "status": { "type": "string", "enum": ["draft", "published"], "description": "Needs the PUBLISH scope." },
          "releaseAt": {
            "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
            "description": "Schedules publication; needs the PUBLISH scope."
          },
          "allowedComments": { "type": "boolean" },
          "mediaRightsReview": {
            "type": "object",
            "required": ["fingerprint", "acknowledged"],
            "properties": { "fingerprint": { "type": "string" }, "acknowledged": { "const": true } },
            "description": "Send it back after a 409 `MEDIA_RIGHTS_REVIEW_REQUIRED` to confirm the media rights the response listed (its `data.report.fingerprint`)."
          },
          "language": { "type": "string", "description": "Content language; the site language when omitted." }
        }
      },
      "ArticleUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "content": {
            "type": "string",
            "maxLength": 500000,
            "description": "HTML. It is sanitized like editor content."
          },
          "excerpt": { "type": ["string", "null"] },
          "slug": {
            "type": "string",
            "maxLength": 100,
            "description": "Normalized; derived from the title when omitted."
          },
          "tags": {
            "type": "array",
            "maxItems": 30,
            "items": { "type": "string", "maxLength": 64 },
            "description": "Slugs of existing tags of the site. The list replaces the article tags."
          },
          "status": { "type": "string", "enum": ["draft", "published"], "description": "Needs the PUBLISH scope." },
          "releaseAt": {
            "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
            "description": "Schedules publication; needs the PUBLISH scope."
          },
          "allowedComments": { "type": "boolean" },
          "mediaRightsReview": {
            "type": "object",
            "required": ["fingerprint", "acknowledged"],
            "properties": { "fingerprint": { "type": "string" }, "acknowledged": { "const": true } },
            "description": "Send it back after a 409 `MEDIA_RIGHTS_REVIEW_REQUIRED` to confirm the media rights the response listed (its `data.report.fingerprint`)."
          },
          "expectedVersion": { "type": "integer", "minimum": 0 }
        }
      },
      "GenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic"],
        "properties": {
          "topic": { "type": "string", "minLength": 3, "maxLength": 500, "description": "The subject to write about." },
          "instructions": {
            "type": "string",
            "maxLength": 2000,
            "description": "Editorial preferences, e.g. audience or angle. They never override Topiqu quality rules."
          }
        }
      },
      "Generation": {
        "type": "object",
        "required": ["id", "topic", "status", "articleId", "error", "createdAt", "startedAt", "finishedAt"],
        "properties": {
          "id": { "type": "string" },
          "topic": { "type": "string" },
          "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed"] },
          "articleId": { "type": ["string", "null"], "description": "The draft article once the request succeeded." },
          "error": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "startedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
          "finishedAt": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
        }
      },
      "GenerationResponse": {
        "type": "object",
        "required": ["data"],
        "properties": { "data": { "$ref": "#/components/schemas/Generation" } }
      },
      "Error": {
        "type": "object",
        "required": ["statusCode", "message"],
        "properties": { "statusCode": { "type": "integer" }, "message": { "type": "string" } }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 400, "message": "Invalid request" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 401, "message": "Missing or invalid API key" }
          }
        }
      },
      "InsufficientCredits": {
        "description": "Insufficient article credits",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 402, "message": "Insufficient article credits" }
          }
        }
      },
      "Forbidden": {
        "description": "The key or its member lacks the required scope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 403, "message": "The key or its member lacks the required scope" }
          }
        }
      },
      "NotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 404, "message": "Not found" }
          }
        }
      },
      "Conflict": {
        "description": "Edit conflict, media rights review required, or the same Idempotency-Key is running or uncertain",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "statusCode": 409,
              "message": "Edit conflict, media rights review required, or the same Idempotency-Key is running or uncertain"
            }
          }
        }
      },
      "IdempotencyMismatch": {
        "description": "The Idempotency-Key was used for a different request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 422, "message": "The Idempotency-Key was used for a different request" }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 429, "message": "Rate limit exceeded" }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "statusCode": 500, "message": "Unexpected server error" }
          }
        }
      }
    }
  }
}
